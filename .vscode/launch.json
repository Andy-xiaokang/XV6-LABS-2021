{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug xv6",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/kernel",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "miDebuggerServerAddress": "localhost:25501",
            "miDebuggerPath": "/opt/homebrew/Cellar/riscv64-elf-gdb/16.3/bin/riscv64-elf-gdb",
